PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ems
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5173

# Seed credentials — only used on first run when DB is empty
SEED_ADMIN_EMAIL=admin@ems.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_EMPLOYEE_PASSWORD=Employee@123

# Cloudinary (for avatar/document uploads — optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (for future email notifications — optional)
EMAIL_USER=
EMAIL_PASS=